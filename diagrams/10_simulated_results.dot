digraph simulated_results {
    graph [bgcolor="#0d1117", fontname="Helvetica", fontcolor="#e6edf3", labelloc="t", fontsize=20, rankdir=TB, label="Headline SIMULATED results (mean completeness of honest receivers) — not measurements"];
    node  [fontname="Helvetica", fontcolor="#e6edf3", color="#30363d", style="filled,rounded", shape=box, penwidth=2, margin="0.25,0.18", fillcolor="#161b22"];
    edge  [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9];
    subgraph cluster_hall { label="one hall, 60 min"; fontcolor="#58a6ff"; color="#58a6ff"; style="rounded";
        h1 [label="≤ 500 devices: 1.00", color="#3fb950"]; h2 [label="1 000 devices: 0.95", color="#3fb950"];
        h3 [label="3 000 devices: 0.40\n(hall moves ~300 kB/s total)", color="#d29922"]; h4 [label="fixed-rate broadcast @ 3 000: 0.00", color="#f85149"]; }
    subgraph cluster_env { label="other environments"; fontcolor="#39c5cf"; color="#39c5cf"; style="rounded";
        e1 [label="6 rooms × 500, walking, 1 h: 0.98", color="#3fb950"]; e2 [label="city 3 000, 24 h, burst mode: 1.00", color="#3fb950"];
        e3 [label="city without burst mode: 0.49", color="#d29922"]; }
    subgraph cluster_base { label="pairwise baseline"; fontcolor="#f0883e"; color="#f0883e"; style="rounded";
        p1 [label="listeners: 0.00 in every scenario", color="#f85149"]; p2 [label="couriers in city: 1.00", color="#3fb950"]; }
    subgraph cluster_adv { label="adversaries"; fontcolor="#f85149"; color="#f85149"; style="rounded";
        a1 [label="10 % flooders (500-device hall): 0.86", color="#d29922"]; a2 [label="20 % flooders (500-device hall): 0.29", color="#f85149"];
        a3 [label="bridges silenced (separate test:\n2 rooms × 200): each side ~0.5", color="#f85149"]; }
    h2 -> e1 [style=invis]; e1 -> p1 [style=invis]; p1 -> a1 [style=invis];
}
